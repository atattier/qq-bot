# 复制成 .env 后填：cp .env.example .env
# （tools/docker_bootstrap.py 发现没有 .env 会自动复制一份，但账号要你确认）

# 要自动登录的 QQ 号（对应容器里的 autoLoginAccount）
# 第一次仍然要扫码一次，之后登录态写在 ./.config 卷里，重启/重建都不用再扫
NAPCAT_ACCOUNT=123450002

# WebUI 登录口令（别用默认 napcat —— 6099 端口是本机可访问的扫码入口）
WEBUI_TOKEN=换成你自己的口令

# 容器内运行用户（Linux 下一般不用改）
NAPCAT_UID=1000
NAPCAT_GID=1000

# Docker Desktop 安装目录（留空 = 官方默认 C:\Program Files\Docker）
DOCKER_INSTALL_DIR=
